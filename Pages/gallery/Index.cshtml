@page "/gallery"
@{
    ViewData["Title"] = "Gallery";
}

<main>

    <section class="page-hero">
        <div class="container">
            <p class="eyebrow">Dobcross in Pictures</p>

            <h1>Gallery</h1>

            <p class="page-hero__intro">
                A collection of photographs celebrating the band, its performances and its community.
            </p>
        </div>
    </section>

        <section class="content-section">
            <div class="container content-section__inner">
                <div class="content-section__heading">
                    <p class="eyebrow">The Band in Action</p>
                </div>

                <div class="content-section__body">
                    <p>Competition performances, concerts, Whit Friday and special occasions will be collected here.</p>
                </div>
            </div>
        </section>
        <section class="content-section">
            <div class="container content-section__inner">
                <div class="content-section__heading">
                    <p class="eyebrow">A Visual History</p>
                </div>

                <div class="content-section__body">
                    <p>The gallery will eventually include photographs from across the band's long history.</p>
                </div>
            </div>
        </section>


    <section class="page-cta">
        <div class="container page-cta__inner">
            <div>
                <p class="eyebrow">Dobcross Silver Band</p>

                <h2>
                    Keep exploring.
                </h2>
            </div>

            <div>
                <a class="button button--primary" href="/">
                    Return Home
                </a>
            </div>
        </div>
    </section>

</main>


