@page
@{
    ViewData["Title"] = "Dobcross Silver Band";
}

<main>

    <!-- HERO -->
    <section class="hero hero--home">
        <div class="hero__image hero__image--band"></div>
        <div class="hero__overlay"></div>

        <div class="hero__content">
            <p class="eyebrow">Established 1875 · Saddleworth</p>

            <h1>
                Dobcross<br />
                Silver Band
            </h1>

            <p class="hero__intro">
                A world-famous brass band proudly representing the village
                of Dobcross and its community for more than 150 years.
            </p>

            <div class="hero__actions">
                <a class="button button--primary" href="/about-the-band">
                    Discover the Band
                </a>

                <a class="button button--ghost" href="/upcoming-events">
                    Upcoming Events
                </a>
            </div>

            <div class="hero__achievement">
                <strong>2025 NATIONAL CHAMPIONS</strong>
                <span>3rd Section · Promoted to 2nd Section</span>
            </div>
        </div>

        <div class="hero__scroll">
            <span>Scroll to explore</span>
            <span class="hero__scroll-line"></span>
        </div>
    </section>


    <!-- INTRODUCTION -->
    <section class="intro-section home-intro">
        <div class="container home-intro__grid">

            <div>
                <p class="eyebrow">The Dobcross Story</p>

                <h2 class="display-heading">
                    Music, competition
                    and community.
                </h2>
            </div>

            <div class="intro-section__content">
                <p>
                    Dobcross Silver Band is a world-famous brass band,
                    established in 1875 and proud to represent the small
                    village community of Dobcross in Saddleworth.
                </p>

                <p>
                    From Whit Friday contests and championship performances
                    to concerts, community events and private engagements,
                    the band continues a tradition that has been part of
                    village life for generations.
                </p>

                <a class="text-link" href="/about-the-band">
                    About the band
                    <span>→</span>
                </a>
            </div>

        </div>
    </section>


    <!-- ACHIEVEMENT -->
    <section class="achievement-section">
        <div class="container achievement-section__inner">

            <div class="achievement-section__number">
                2025
            </div>

            <div>
                <p class="eyebrow">National Brass Band Championships</p>

                <h2>
                    National<br />
                    Champions.
                </h2>

                <p>
                    The Silver Band were crowned Third Section National
                    Champions at Cheltenham in September 2025, securing
                    the band's second National Finals victory in three years.
                </p>

                <a class="text-link text-link--light" href="/results">
                    View our results
                    <span>→</span>
                </a>
            </div>

        </div>
    </section>


    <!-- NEXT EVENT -->
    <section class="event-feature">
        <div class="container">

            <div class="section-heading">
                <p class="eyebrow">Next at the Band Club</p>

                <h2>
                    An afternoon<br />
                    of brass.
                </h2>
            </div>

            <div class="event-feature__card">

                <div class="event-feature__date">
                    <span class="event-feature__day">30</span>
                    <span class="event-feature__month">AUG</span>
                    <span class="event-feature__year">2026</span>
                </div>

                <div class="event-feature__details">
                    <p class="event-feature__time">2.00pm</p>

                    <h3>
                        The Middleton Band
                    </h3>

                    <p>
                        Showcase Brass at Dobcross Band Club
                    </p>

                    <a class="button button--dark" href="/upcoming-events">
                        All Events
                    </a>
                </div>

            </div>

        </div>
    </section>


    <!-- NEWS -->
    <section class="news-section">
        <div class="container">

            <div class="section-heading section-heading--split">
                <div>
                    <p class="eyebrow">From the Band</p>
                    <h2>Latest News</h2>
                </div>

                <a class="text-link" href="/latest-news">
                    View all news
                    <span>→</span>
                </a>
            </div>

            <div class="news-grid">

                <article class="news-card">
                    <div class="news-card__image news-card__image--one"></div>

                    <div class="news-card__content">
                        <p class="news-card__date">25 June 2026</p>

                        <h3>
                            Brass on the Grass
                        </h3>

                        <p>
                            Our annual free concert returns to Dobcross
                            with an afternoon of live brass music.
                        </p>

                        <a class="text-link" href="/latest-news">
                            Read more
                            <span>→</span>
                        </a>
                    </div>
                </article>


                <article class="news-card">
                    <div class="news-card__image news-card__image--two"></div>

                    <div class="news-card__content">
                        <p class="news-card__date">8 June 2026</p>

                        <h3>
                            Support the Silver Band
                        </h3>

                        <p>
                            Find out how Easyfundraising can help support
                            the band simply by shopping online.
                        </p>

                        <a class="text-link" href="/latest-news">
                            Read more
                            <span>→</span>
                        </a>
                    </div>
                </article>


                <article class="news-card">
                    <div class="news-card__image news-card__image--three"></div>

                    <div class="news-card__content">
                        <p class="news-card__date">5 June 2026</p>

                        <h3>
                            Sounds of Silver
                        </h3>

                        <p>
                            Music from 2003 has been added to our
                            growing archive of historic recordings.
                        </p>

                        <a class="text-link" href="/latest-news">
                            Read more
                            <span>→</span>
                        </a>
                    </div>
                </article>

            </div>

        </div>
    </section>


    <!-- HERITAGE -->
    <section class="heritage-section home-heritage">
        <div class="container heritage-section__inner">

            <div>
                <p class="eyebrow">Since 1875</p>

                <h2>
                    A village band
                    with a very big history.
                </h2>
            </div>

            <div>
                <p>
                    Based at the famous Dobcross Band and Social Club,
                    the Silver Band has enjoyed success at the highest
                    levels of brass banding throughout its history.
                </p>

                <p>
                    Today that tradition continues through the Silver Band,
                    Dobcross Youth Band and the next generation of players
                    being developed in our community.
                </p>

                <a class="button button--dark" href="/about-the-band">
                    Our History
                </a>
            </div>

        </div>
    </section>


    <!-- EXPLORE -->
    <section class="explore-section">
        <div class="container">

            <p class="eyebrow">Explore Dobcross</p>

            <div class="explore-grid">

                <a class="explore-card" href="/meet-the-band">
                    <span class="explore-card__number">01</span>
                    <span class="explore-card__title">Meet the Band</span>
                    <span class="explore-card__arrow">→</span>
                </a>

                <a class="explore-card" href="/gallery">
                    <span class="explore-card__number">02</span>
                    <span class="explore-card__title">Gallery</span>
                    <span class="explore-card__arrow">→</span>
                </a>

                <a class="explore-card" href="/media-links">
                    <span class="explore-card__number">03</span>
                    <span class="explore-card__title">Media & Archive</span>
                    <span class="explore-card__arrow">→</span>
                </a>

                <a class="explore-card" href="/contact">
                    <span class="explore-card__number">04</span>
                    <span class="explore-card__title">Book the Band</span>
                    <span class="explore-card__arrow">→</span>
                </a>

            </div>

        </div>
    </section>


    <!-- SUPPORT -->
    <section class="support-section">
        <div class="container support-section__inner">

            <div>
                <p class="eyebrow">Support the Band</p>

                <h2>
                    Help keep the
                    music playing.
                </h2>
            </div>

            <div>
                <p>
                    The Dobcross Silver Band is maintained through the
                    generosity of our supporters, friends and local
                    community.
                </p>

                <p>
                    Every contribution helps us continue brass band music
                    in Dobcross for future generations.
                </p>

                <div class="hero__actions">
                    <a class="button button--primary" href="/useful-links">
                        Support Us
                    </a>

                    <a class="button button--ghost button--ghost-dark" href="/contact">
                        Contact the Band
                    </a>
                </div>
            </div>

        </div>
    </section>

</main>
