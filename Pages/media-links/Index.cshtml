@page "/media-links"
@{
    ViewData["Title"] = "Media & Archive";
}

<main>

    <section class="page-hero">
        <div class="container">
            <p class="eyebrow">Listen · Watch · Explore</p>

            <h1>Media & Archive</h1>

            <p class="page-hero__intro">
                Explore recordings, videos, historical material and other media from Dobcross Silver Band.
            </p>
        </div>
    </section>

        <section class="content-section">
            <div class="container content-section__inner">
                <div class="content-section__heading">
                    <p class="eyebrow">Recordings</p>
                </div>

                <div class="content-section__body">
                    <p>Audio recordings and performances will be collected here.</p>
                </div>
            </div>
        </section>
        <section class="content-section">
            <div class="container content-section__inner">
                <div class="content-section__heading">
                    <p class="eyebrow">Video</p>
                </div>

                <div class="content-section__body">
                    <p>Concerts, contests and other performances can be showcased here.</p>
                </div>
            </div>
        </section>
        <section class="content-section">
            <div class="container content-section__inner">
                <div class="content-section__heading">
                    <p class="eyebrow">Archive</p>
                </div>

                <div class="content-section__body">
                    <p>Historic programmes, photographs and other material will eventually form part of a searchable digital archive.</p>
                </div>
            </div>
        </section>


    <section class="page-cta">
        <div class="container page-cta__inner">
            <div>
                <p class="eyebrow">Dobcross Silver Band</p>

                <h2>
                    Keep exploring.
                </h2>
            </div>

            <div>
                <a class="button button--primary" href="/">
                    Return Home
                </a>
            </div>
        </div>
    </section>

</main>


