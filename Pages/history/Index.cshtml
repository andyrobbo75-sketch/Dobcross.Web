@page "/history"
@{
    ViewData["Title"] = "History";
}

<main>

    <section class="page-hero">
        <div class="container">
            <p class="eyebrow">Since 1875</p>

            <h1>A Very Long History</h1>

            <p class="page-hero__intro">
                More than 150 years of music, competition and community.
            </p>
        </div>
    </section>

        <section class="content-section">
            <div class="container content-section__inner">
                <div class="content-section__heading">
                    <p class="eyebrow">1875</p>
                </div>

                <div class="content-section__body">
                    <p>Dobcross Silver Band was established in 1875 and has remained closely connected with the village and surrounding Saddleworth community ever since.</p>
                </div>
            </div>
        </section>
        <section class="content-section">
            <div class="container content-section__inner">
                <div class="content-section__heading">
                    <p class="eyebrow">Generations of Musicians</p>
                </div>

                <div class="content-section__body">
                    <p>Players have passed through the band across generations, creating a remarkable musical heritage and a tradition that continues today.</p>
                </div>
            </div>
        </section>
        <section class="content-section">
            <div class="container content-section__inner">
                <div class="content-section__heading">
                    <p class="eyebrow">The Story Continues</p>
                </div>

                <div class="content-section__body">
                    <p>The history section will eventually become a detailed interactive timeline containing important people, performances, contests and milestones.</p>
                </div>
            </div>
        </section>


    <section class="page-cta">
        <div class="container page-cta__inner">
            <div>
                <p class="eyebrow">Dobcross Silver Band</p>

                <h2>
                    Keep exploring.
                </h2>
            </div>

            <div>
                <a class="button button--primary" href="/">
                    Return Home
                </a>
            </div>
        </div>
    </section>

</main>


