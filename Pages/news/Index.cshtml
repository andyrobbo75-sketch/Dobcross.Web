@page "/news/{id}"

@using OrchardCore

@inject IOrchardHelper Orchard

@{
    ViewData["Title"] = "News";
    var newsItem = await Orchard.GetContentItemByIdAsync(Id);
}

<main>

    @if (newsItem == null)
    {
        <section class="page-hero">
            <div class="container">
                <p class="eyebrow">Dobcross Silver Band</p>
                <h1>News article not found</h1>

                <p class="page-hero__intro">
                    The requested news article could not be found.
                </p>
            </div>
        </section>

        <section class="content-section">
            <div class="container">
                <a class="text-link" href="/latest-news">
                    ? Back to Latest News
                </a>
            </div>
        </section>
    }
    else
    {
        <article class="news-article">

            <header class="page-hero">
                <div class="container">

                    <p class="eyebrow">
                        Dobcross Silver Band
                    </p>

                    <h1>
                        @newsItem.DisplayText
                    </h1>

                    @if (newsItem.PublishedUtc.HasValue)
                    {
                        <p class="page-hero__intro">
                            @(newsItem.PublishedUtc.Value.ToLocalTime().ToString("d MMMM yyyy"))
                        </p>
                    }

                </div>
            </header>

            <section class="content-section">
                <div class="container">

                    @if (newsItem.Content?.MarkdownBodyPart?.Markdown != null)
                    {
                        <div class="news-article__body">

                            @await Orchard.MarkdownToHtmlAsync(
                                (string)newsItem.Content.MarkdownBodyPart.Markdown
                            )

                        </div>
                    }

                    <div class="news-article__back">

                        <a class="text-link" href="/latest-news">
                            ? Back to Latest News
                        </a>

                    </div>

                </div>
            </section>

        </article>
    }

</main>

@functions
{
    [FromRoute]
    public string? Id { get; set; }
}




