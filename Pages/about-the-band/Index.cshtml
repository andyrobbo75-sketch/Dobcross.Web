@page "/about-the-band"
@{
    ViewData["Title"] = "About the Band";
}

<main>

    <section class="page-hero">
        <div class="container">
            <p class="eyebrow">Dobcross Silver Band</p>

            <h1>A proud tradition of music, competition and community.</h1>

            <p class="page-hero__intro">
                Established in 1875, Dobcross Silver Band has been at the heart of village life for more than 150 years.
            </p>
        </div>
    </section>

    <section class="content-section">
        <div class="container content-section__inner">
            <div class="content-section__heading">
                <p class="eyebrow">The Silver Band</p>
            </div>

            <div class="content-section__body">
                <p>
                    Dobcross Silver Band is one of the most recognised brass bands in the North of England.
                    Based in the village of Dobcross in Saddleworth, the band combines a strong competitive
                    tradition with concerts, community events and a passion for brass band music.
                </p>
            </div>
        </div>
    </section>

    <section class="content-section">
        <div class="container content-section__inner">
            <div class="content-section__heading">
                <p class="eyebrow">Our Home</p>
            </div>

            <div class="content-section__body">
                <p>
                    The band is based at Dobcross Band and Social Club, a venue that has played an important
                    part in the band's history and continues to provide a home for rehearsals, performances
                    and social events.
                </p>
            </div>
        </div>
    </section>

    <section class="content-section">
        <div class="container content-section__inner">
            <div class="content-section__heading">
                <p class="eyebrow">Looking Forward</p>
            </div>

            <div class="content-section__body">
                <p>
                    While proud of its history, the band is firmly focused on the future, developing players,
                    supporting younger musicians and continuing to represent Dobcross wherever the band performs.
                </p>
            </div>
        </div>
    </section>

    <section class="page-cta">
        <div class="container page-cta__inner">
            <div>
                <p class="eyebrow">Dobcross Silver Band</p>

                <h2>
                    Keep exploring.
                </h2>
            </div>

            <div>
                <a class="button button--primary" href="/">
                    Return Home
                </a>
            </div>
        </div>
    </section>

</main>
