@page "/contact"
@{
    ViewData["Title"] = "Contact";
}

<main>

    <section class="page-hero">
        <div class="container">
            <p class="eyebrow">Get in Touch</p>

            <h1>Contact Dobcross Silver Band</h1>

            <p class="page-hero__intro">
                Whether you're interested in booking the band, supporting us or simply getting in touch, we'd love to hear from you.
            </p>
        </div>
    </section>

        <section class="content-section">
            <div class="container content-section__inner">
                <div class="content-section__heading">
                    <p class="eyebrow">Book the Band</p>
                </div>

                <div class="content-section__body">
                    <p>For concert bookings, private engagements and other enquiries, please contact the band using the details provided.</p>
                </div>
            </div>
        </section>
        <section class="content-section">
            <div class="container content-section__inner">
                <div class="content-section__heading">
                    <p class="eyebrow">General Enquiries</p>
                </div>

                <div class="content-section__body">
                    <p>Questions about the band, events or membership can be directed to the appropriate contact.</p>
                </div>
            </div>
        </section>


    <section class="page-cta">
        <div class="container page-cta__inner">
            <div>
                <p class="eyebrow">Dobcross Silver Band</p>

                <h2>
                    Keep exploring.
                </h2>
            </div>

            <div>
                <a class="button button--primary" href="/">
                    Return Home
                </a>
            </div>
        </div>
    </section>

</main>


