@page "/useful-links"
@{
    ViewData["Title"] = "Support Us";
}

<main>

    <section class="page-hero">
        <div class="container">
            <p class="eyebrow">Support Dobcross Silver Band</p>

            <h1>Help Keep the Music Playing</h1>

            <p class="page-hero__intro">
                The support of our friends, members and community helps ensure the band's future.
            </p>
        </div>
    </section>

        <section class="content-section">
            <div class="container content-section__inner">
                <div class="content-section__heading">
                    <p class="eyebrow">Support the Band</p>
                </div>

                <div class="content-section__body">
                    <p>There are several ways to support Dobcross Silver Band, from attending concerts and events to supporting fundraising activities.</p>
                </div>
            </div>
        </section>
        <section class="content-section">
            <div class="container content-section__inner">
                <div class="content-section__heading">
                    <p class="eyebrow">Easyfundraising</p>
                </div>

                <div class="content-section__body">
                    <p>Information about Easyfundraising and other ways of supporting the band will be available here.</p>
                </div>
            </div>
        </section>


    <section class="page-cta">
        <div class="container page-cta__inner">
            <div>
                <p class="eyebrow">Dobcross Silver Band</p>

                <h2>
                    Keep exploring.
                </h2>
            </div>

            <div>
                <a class="button button--primary" href="/">
                    Return Home
                </a>
            </div>
        </div>
    </section>

</main>


