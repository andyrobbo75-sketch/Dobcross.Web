@page "/meet-the-band"
@{
    ViewData["Title"] = "Meet the Band";
}

<main>

    <section class="page-hero">
        <div class="container">
            <p class="eyebrow">The People Behind the Music</p>

            <h1>Meet the Band</h1>

            <p class="page-hero__intro">
                The musicians who make Dobcross Silver Band what it is.
            </p>
        </div>
    </section>

        <section class="content-section">
            <div class="container content-section__inner">
                <div class="content-section__heading">
                    <p class="eyebrow">Our Players</p>
                </div>

                <div class="content-section__body">
                    <p>Player profiles, sections and musical roles will be added here.</p>
                </div>
            </div>
        </section>
        <section class="content-section">
            <div class="container content-section__inner">
                <div class="content-section__heading">
                    <p class="eyebrow">Musical Team</p>
                </div>

                <div class="content-section__body">
                    <p>The musical leadership and team behind the band's performances will be featured here.</p>
                </div>
            </div>
        </section>


    <section class="page-cta">
        <div class="container page-cta__inner">
            <div>
                <p class="eyebrow">Dobcross Silver Band</p>

                <h2>
                    Keep exploring.
                </h2>
            </div>

            <div>
                <a class="button button--primary" href="/">
                    Return Home
                </a>
            </div>
        </div>
    </section>

</main>


